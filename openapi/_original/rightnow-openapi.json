          "text": {
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RerankContentPart"
            }
          }
        }
      },
      "RerankScore": {
        "type": "object",
        "required": [
          "index",
          "score"
