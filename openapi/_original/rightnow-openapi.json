              "type": "string"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RerankDocument"
            },
            "minItems": 1,
            "maxItems": 500
          },
          "top_n": {
            "type": "integer",
            "minimum": 1,
            "description": "Optional number of ranked results to return."
          }
        },
        "oneOf": [
          {
            "required": [
              "texts"
            ]
          },
          {
            "required": [
              "documents"
            ]
          }
        ]
      },
